{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-fable-5",
  "fallbackModel": [
    "claude-opus-4-8",
    "claude-sonnet-5"
  ],
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(jq:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(which:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(git mv:*)",
      "Bash(git rev-parse:*)",
      "Bash(git worktree:*)",
      "Agent",
      "Bash(*/engine/bin/engine-ticket *)",
      "Bash(*/engine/*/bin/engine-ticket *)",
      "Bash(*/engine/bin/engine-ship-commit *)",
      "Bash(*/engine/*/bin/engine-ship-commit *)",
      "Bash(*/engine/preview/local-up *)",
      "Bash(*/engine/*/preview/local-up *)",
      "Bash(*/engine/preview/local-down *)",
      "Bash(*/engine/*/preview/local-down *)",
      "Bash(*/engine/browser/qa-browser *)",
      "Bash(*/engine/*/browser/qa-browser *)",
      "Bash(lsof -nP -iTCP*)",
      "Bash(ipconfig getifaddr *)",
      "Bash(ps -p *)",
      "Bash(curl -s http://127.0.0.1*)",
      "Bash(curl -s http://localhost*)",
      "Bash(curl http://127.0.0.1*)",
      "Bash(curl http://localhost*)",
      "Bash(curl -s \"http://127.0.0.1*)",
      "Bash(curl -s \"http://localhost*)",
      "Bash(curl \"http://127.0.0.1*)",
      "Bash(curl \"http://localhost*)",
      "Bash(npm run check *)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(gh repo delete:*)",
      "Bash(launchctl bootout:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*)"
    ]
  }
}
